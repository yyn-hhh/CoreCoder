# Copy this file to `.env` and fill in your OpenAI-compatible API key.
# CoreCoder loads `.env` from the project root on startup.
OPENAI_API_KEY=

# Optional overrides (uncomment and edit as needed):
# OPENAI_BASE_URL=https://api.deepseek.com
# CORECODER_MODEL=deepseek-chat
# CORECODER_PROVIDER=openai

# LiteLLM backend for non-OpenAI-compatible providers:
# CORECODER_PROVIDER=litellm
